      "item": [
        {
          "id": "81c30e09-87d5-4905-b24c-aca27ee56af5",
          "name": "Get Custom Report Data",
          "request": {
            "name": "Get Custom Report Data",
            "description": {
              "content": "Returns data from a custom report published as a web service. The report owner and report name form the path to the report. Supports filtering via report-specific prompt parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":reportOwner",
                ":reportName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "The output format for the report data. Supported values are json, csv, simplexml, and gdata."
                },
                {
                  "disabled": false,
                  "key": "Worker!WID",
                  "value": "<string>",
                  "description": "Filter by worker Workday ID (example prompt parameter)."
                },
                {
                  "disabled": false,
                  "key": "Effective_as_of_Date",
                  "value": "<date>",
                  "description": "Filter by effective date (example prompt parameter)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportOwner",
                  "description": "(Required) The username of the report owner (e.g., ISU_report_owner)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportName",
                  "description": "(Required) The name of the custom report."
                },
                {
                  "description": "The Workday tenant identifier",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
