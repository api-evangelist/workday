{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Benefits API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://wd2-impl-services1.workday.com/ccx/oauth2/{tenant}/authorize",
      "accessTokenUrl": "https://wd2-impl-services1.workday.com/ccx/oauth2/{tenant}/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Benefit Elections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Benefit Elections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/benefits/v1/{tenant}/workers/:ID/benefitElections",
            "params": [
              {
                "name": "ID",
                "value": "",
                "type": "path",
                "description": "The Workday ID of the worker."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of objects in a single response."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The zero-based index of the first object in a response collection."
              }
            ]
          },
          "docs": "Returns current benefit elections for a worker."
        },
        {
          "info": {
            "name": "Change Benefits",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/benefits/v1/{tenant}/workers/:ID/changeBenefits",
            "params": [
              {
                "name": "ID",
                "value": "",
                "type": "path",
                "description": "The Workday ID of the worker."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates a benefit change event for a worker."
        }
      ]
    },
    {
      "info": {
        "name": "Benefit Plans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Eligible Benefit Plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/benefits/v1/{tenant}/workers/:ID/eligibleBenefitPlans",
            "params": [
              {
                "name": "ID",
                "value": "",
                "type": "path",
                "description": "The Workday ID of the worker."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of objects in a single response."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The zero-based index of the first object in a response collection."
              }
            ]
          },
          "docs": "Returns benefit plans a worker is eligible for."
        },
        {
          "info": {
            "name": "Get Benefit Plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/benefits/v1/{tenant}/benefitPlans",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of objects in a single response."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The zero-based index of the first object in a response collection."
              }
            ]
          },
          "docs": "Returns a collection of benefit plans."
        }
      ]
    },
    {
      "info": {
        "name": "Dependents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Dependents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/benefits/v1/{tenant}/workers/:ID/dependents",
            "params": [
              {
                "name": "ID",
                "value": "",
                "type": "path",
                "description": "The Workday ID of the worker."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of objects in a single response."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The zero-based index of the first object in a response collection."
              }
            ]
          },
          "docs": "Returns dependents for a worker."
        }
      ]
    }
  ],
  "bundled": true
}