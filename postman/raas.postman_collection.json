{
  "info": {
    "_postman_id": "b7fb158c-8098-45cf-9546-c978d3d70f75",
    "name": "Workday Report-as-a-Service API",
    "description": "Report-as-a-Service (RaaS) exposes custom reports as RESTful web services, enabling programmatic access to report data. Supports query parameters for filtering and returns data in multiple formats including JSON, CSV, and XML.\n\nContact Support:\n Name: Workday Support\n Email: support@workday.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:22:28.000Z",
    "updatedAt": "2026-06-05T15:22:28.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-b7fb158c-8098-45cf-9546-c978d3d70f75"
  },
