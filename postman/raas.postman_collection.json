      "name": "{reportOwner}",
      "item": [
        {
          "name": "{reportName}",
          "item": [
            {
              "name": "Get Custom Report Data",
              "id": "8d1912f9-43d3-4fde-87c5-3b2cb569644e",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/:reportOwner/:reportName?format=json&Worker!WID=<string>&Effective_as_of_Date=<date>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    ":reportOwner",
                    ":reportName"
                  ],
                  "query": [
                    {
                      "description": "The output format for the report data. Supported values are json, csv, simplexml, and gdata.",
                      "key": "format",
                      "value": "json"
                    },
                    {
                      "description": "Filter by worker Workday ID (example prompt parameter).",
                      "key": "Worker!WID",
                      "value": "<string>"
                    },
                    {
                      "description": "Filter by effective date (example prompt parameter).",
                      "key": "Effective_as_of_Date",
                      "value": "<date>"
                    }
                  ],
                  "variable": [
                    {
                      "id": "af4aaa3b-2547-42b1-8e62-bad6605a19a9",
                      "key": "reportOwner",
                      "value": "<string>",
                      "description": "(Required) The username of the report owner (e.g., ISU_report_owner)."
                    },
                    {
                      "id": "34566111-be2f-4b8e-ba45-ba08b91e3f8a",
                      "key": "reportName",
                      "value": "<string>",
                      "description": "(Required) The name of the custom report."
                    }
                  ]
                },
                "description": "Returns data from a custom report published as a web service. The report owner and report name form the path to the report. Supports filtering via report-specific prompt parameters."
              },
