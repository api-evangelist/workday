{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "Table",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "descriptor": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fields": {
      "type": "array"
    },
    "isAccessible": {
      "type": "boolean"
    },
    "documentCount": {
      "type": "integer"
    }
  }
}