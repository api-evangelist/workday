{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Prospect",
  "title": "Prospect",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "email": {
      "type": "string",
      "format": "email",
      "example": "user@example.com"
    },
    "phone": {
      "type": "string",
      "example": "example_value"
    },
    "talentPool": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "source": {
      "$ref": "#/components/schemas/ResourceReference"
    }
  }
}