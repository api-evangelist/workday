{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DataChangeTask",
  "title": "DataChangeTask",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The Workday ID of the data change task.",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "targetDataset": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "status": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "descriptor": {
          "type": "string"
        }
      },
      "description": "The status of the task (e.g., New, Processing, Complete, Error).",
      "example": "example_value"
    },
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "descriptor": {
          "type": "string"
        }
      },
      "description": "The operation type (e.g., FullReplace, Append).",
      "example": "example_value"
    },
    "fileContainer": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "createdOn": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "completedOn": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    }
  }
}