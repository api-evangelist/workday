{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Certification",
  "title": "Certification",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "issuer": {
      "type": "string",
      "example": "example_value"
    },
    "issuedDate": {
      "type": "string",
      "format": "date",
      "example": "2026-01-15"
    },
    "expirationDate": {
      "type": "string",
      "format": "date",
      "example": "2026-01-15"
    }
  }
}