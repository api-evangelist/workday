{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Country",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "descriptor": {
      "type": "string"
    },
    "countryCode": {
      "type": "string",
      "description": "The ISO 3166-1 alpha-3 country code."
    },
    "alpha2Code": {
      "type": "string",
      "description": "The ISO 3166-1 alpha-2 country code."
    },
    "name": {
      "type": "string"
    }
  }
}