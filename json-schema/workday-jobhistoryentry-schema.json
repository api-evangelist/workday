{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/JobHistoryEntry",
  "title": "JobHistoryEntry",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "company": {
      "type": "string",
      "example": "example_value"
    },
    "jobTitle": {
      "type": "string",
      "example": "example_value"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "example": "2026-01-15"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "example": "2026-01-15"
    },
    "description": {
      "type": "string",
      "example": "A sample description."
    }
  }
}