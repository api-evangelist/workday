{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimeEntry",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "descriptor": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "description": "The number of hours entered."
    },
    "comment": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  }
}