{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/FileContainer",
  "title": "FileContainer",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The Workday ID of the file container.",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "expirationTime": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    }
  }
}