{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "descriptor": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "The full name of the candidate."
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "attachments": {
      "type": "array"
    }
  }
}