{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PersonSummary",
  "title": "PersonSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "href": {
      "type": "string",
      "format": "uri",
      "example": "https://www.example.com"
    }
  }
}