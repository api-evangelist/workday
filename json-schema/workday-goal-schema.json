{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Goal",
  "title": "Goal",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "description": {
      "type": "string",
      "example": "A sample description."
    },
    "status": {
      "type": "string",
      "description": "The status of the goal (e.g., Not Started, In Progress, Completed).",
      "example": "example_value"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "example": "2026-01-15"
    },
    "completionDate": {
      "type": "string",
      "format": "date",
      "example": "2026-01-15"
    },
    "category": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "weight": {
      "type": "number",
      "format": "double",
      "example": 42.5
    }
  }
}