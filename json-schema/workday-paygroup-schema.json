{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PayGroup",
  "title": "PayGroup",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "country": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "payFrequency": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "currency": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "isActive": {
      "type": "boolean",
      "example": true
    }
  }
}