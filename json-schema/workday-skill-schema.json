{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Skill",
  "title": "Skill",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "descriptor": {
      "type": "string",
      "example": "example_value"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "category": {
      "$ref": "#/components/schemas/ResourceReference"
    },
    "proficiencyLevel": {
      "$ref": "#/components/schemas/ResourceReference"
    }
  }
}